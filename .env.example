# Gemini API Key for AI enrichment in parser.py
GEMINI_API_KEY=your-gemini-api-key-here

# SysReptor API Key for reptor CLI authentication
REPTOR_API_KEY=your-reptor-api-key-here

# SysReptor Server URL
REPTOR_SERVER=https://your-sysreptor-instance.com

# SysReptor Design ID (required by reptor createproject -d)
REPTOR_DESIGN_ID=your-design-id-here

# --- Server / security settings ---

# Bind address. Defaults to 127.0.0.1 (loopback). Set to 0.0.0.0 to expose the
# server on all interfaces (only do this behind auth and/or a firewall/proxy).
HOST=127.0.0.1

# Port to listen on (default 8000).
PORT=8000

# Enable the Flask debugger. MUST stay off in production (it allows RCE).
# Set to 1/true only for local development.
FLASK_DEBUG=0

# Optional HTTP Basic Auth. When BOTH are set, every route requires these
# credentials. Strongly recommended whenever HOST is not loopback.
APP_AUTH_USER=
APP_AUTH_PASS=
